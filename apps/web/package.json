{
  "name": "trademetrix-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:interactive": "node scripts/browser/audit_interactive.js",
    "build": "next build",
    "build:local": "NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1 NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/api/v1/marketdata/ws NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000 next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "test:lib": "rm -rf dist-test && tsc $(find lib -name '*.test.ts') --outDir dist-test --module commonjs --target es2020 --moduleResolution node --skipLibCheck --esModuleInterop && node --test dist-test/",
    "verify:browser": "node scripts/browser/verify_local_demo.js",
    "verify:contracts": "node scripts/browser/crawl_all_routes.js --out /tmp/contract_audit && python3 scripts/audit_api_contracts.py --signatures /tmp/contract_audit/response_signatures.json",
    "verify:envelopes": "node scripts/browser/verify_envelope_pages.js",
    "verify:running": "node scripts/browser/verify_running_count.js",
    "verify:interact": "node scripts/browser/interact.js",
    "verify:session": "node scripts/browser/verify_session_survives_reload.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "lightweight-charts": "^5.2.0",
    "next": "14.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.1.0",
    "typescript": "^5.4.0"
  }
}
